# ── Twitch ──────────────────────────────────────────────────────────────────
# Register your app at https://dev.twitch.tv/console to get Client ID + Secret.
# Then run:  python3 get_token.py
# It opens a browser, handles the OAuth flow, and writes TWITCH_TOKEN here.

# From https://dev.twitch.tv/console → your app → Manage
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here

# Filled in automatically by get_token.py — do not edit manually
TWITCH_TOKEN=oauth:your_token_here

# Twitch username for the bot account (lowercase)
TWITCH_USERNAME=your_bot_username

# Your channel name (no #, lowercase)
TWITCH_CHANNEL=your_channel_name

# ── LLM (Ollama) ─────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Pet ──────────────────────────────────────────────────────────────────────
PET_NAME=Pixel
PET_PERSONALITY=You are a cute, friendly, and witty stream pet. Keep answers to 1-3 sentences. Be fun and engaging.

# ── TTS (Piper) ───────────────────────────────────────────────────────────────
PIPER_BINARY=./piper/piper
PIPER_MODEL=./piper/en_US-amy-medium.onnx

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# ── Behaviour ────────────────────────────────────────────────────────────────
# Seconds before the same user can !ask again
COOLDOWN_SECONDS=15
# Max LLM response length in tokens (~75 words)
MAX_TOKENS=150
